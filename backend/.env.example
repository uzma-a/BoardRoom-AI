# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- App ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Gemini / Google ADK ---
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
# NOTE: free-tier API keys currently have a 0 requests/day quota for
# gemini-2.5-pro. Keep this on gemini-2.5-flash unless your key has billing
# enabled (https://ai.google.dev/gemini-api/docs/rate-limits).
GEMINI_MODEL_PRO=gemini-2.5-flash
GEMINI_MODEL_FLASH=gemini-2.5-flash

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- MCP Servers ---
MCP_WEB_SEARCH_ENABLED=true
MCP_FILESYSTEM_ENABLED=true
MCP_GITHUB_ENABLED=false

# Only needed if MCP_GITHUB_ENABLED=true
GITHUB_TOKEN=

# Only needed if the Brave Search MCP server is used (see mcp/web_search.py)
BRAVE_API_KEY=

MCP_FILESYSTEM_ROOT=./board_sessions

# --- Security ---
MAX_IDEA_LENGTH=2000
MIN_IDEA_LENGTH=10
REQUEST_TIMEOUT_SECONDS=90
AGENT_TIMEOUT_SECONDS=45

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=10
